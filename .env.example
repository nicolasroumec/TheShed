# Database Configuration
DB_CONNECTION_STRING=Server=localhost;Database=SwimAnalytics;User Id=sa;Password=YourPassword123;TrustServerCertificate=true

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-here-minimum-32-characters-long
JWT_ISSUER=SwimAnalytics
JWT_AUDIENCE=SwimAnalytics
JWT_EXPIRATION_MINUTES=60

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@swimanalytics.com
SENDER_NAME=SwimAnalytics

# External APIs
API_KEY=your-api-key-here
API_SECRET=your-api-secret-here

# Application URLs
API_BASE_URL=https://localhost:7000
CLIENT_BASE_URL=https://localhost:5000

# Environment
ASPNETCORE_ENVIRONMENT=Development
