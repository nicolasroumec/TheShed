{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "// NOTA": "Los valores de abajo NO van en appsettings.json. Usar dotnet user-secrets (dev) o variables de entorno (prod).",

  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=TheShedDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=true"
  },
  "Jwt": {
    "SecretKey": "YOUR_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "TheShed",
    "Audience": "TheShed",
    "ExpirationMinutes": 60
  }
}
