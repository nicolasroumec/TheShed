{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=TheShed;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "TheShed",
    "Audience": "TheShedClient",
    "ExpiryMinutes": 60
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowMinutes": 5
  },
  "Trash": {
    "RetentionDays": 30
  },
  "Attachments": {
    "StoragePath": "App_Data/attachments",
    "MaxFileSizeBytes": 5242880
  }
}
