<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Version>0.4.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Fingerprinted assets are resolved through an inline <script type="importmap">, which the
         Content-Security-Policy blocks unless script-src allows inline scripts. Turning
         fingerprinting off keeps the strict script-src the CSP is there for.
         ponytail: the cost is filename-based cache busting on deploy (blazor.boot.json still
         carries content hashes, so the runtime revalidates). To get it back, compute the SHA-256
         of the rendered import map per response and add it to script-src as an SRI hash. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- blazor.webassembly.js has its own fingerprinting switch, gated by
         OverrideHtmlAssetPlaceholders (SDK targets) rather than WasmFingerprintAssets above.
         Enabling that property to turn this off requires resolving "#[.{fingerprint}]" in
         index.html via MapStaticAssets, which this project doesn't use (Program.cs stays on
         UseStaticFiles/MapFallbackToFile — the classic pipeline D8 already chose over the
         MapStaticAssets/importmap route). So instead: force the loader unfingerprinted and
         reference its now-deterministic filename directly in index.html (see the <script> tag),
         no placeholder involved. Found+fixed verifying Sprint 31 Increment 4's
         `dotnet publish -c Release` — never exercised before this sprint, so this had been
         silently broken (stuck on "Loading", 404 on the literal placeholder text) since D8. -->
    <BlazorFingerprintBlazorJs>false</BlazorFingerprintBlazorJs>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheShed.Shared\TheShed.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
