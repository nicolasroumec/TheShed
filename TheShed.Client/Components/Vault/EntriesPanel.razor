@if (!string.IsNullOrEmpty(_listError))
{
    <div class="alert alert-danger" role="alert">@_listError</div>
}

@if (_form is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(_editingId is null ? "New entry" : "Edit entry")</h5>
            <EditForm Model="@_form" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="name">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="_form.Name" />
                    <ValidationMessage For="@(() => _form.Name)" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="username">Username</label>
                    <InputText id="username" class="form-control" @bind-Value="_form.Username" autocomplete="off" />
                    <ValidationMessage For="@(() => _form.Username)" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <div class="input-group">
                        <InputText id="password" type="@(_showPassword ? "text" : "password")" class="form-control secret" @bind-Value="_form.Password" autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _showPassword = !_showPassword">
                            @(_showPassword ? "Hide" : "Show")
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _form.Password)" />
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GeneratePassword">Generate</button>
                        <label class="form-label mb-0 small">Length</label>
                        <input type="number" min="4" max="128" class="form-control form-control-sm" style="width: 5rem"
                               @bind="_genLength" />
                        <div class="form-check mb-0">
                            <input id="gen-symbols" type="checkbox" class="form-check-input" @bind="_genSymbols" />
                            <label class="form-check-label small" for="gen-symbols">Symbols</label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="url">URL (optional)</label>
                    <InputText id="url" class="form-control" @bind-Value="_form.Url" />
                    <ValidationMessage For="@(() => _form.Url)" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="notes">Notes (optional)</label>
                    <InputTextArea id="notes" class="form-control" @bind-Value="_form.Notes" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox id="favorite" class="form-check-input" @bind-Value="_form.IsFavorite" />
                    <label class="form-check-label" for="favorite">Favorite</label>
                </div>

                @if (_editingId is not null && _tags.Count > 0)
                {
                    <div class="mb-3">
                        <label class="form-label">Tags</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in _tags)
                            {
                                var assigned = _formTagIds.Contains(tag.Id);
                                <button type="button"
                                        class="btn btn-sm @(assigned ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="() => ToggleEntryTagAsync(tag.Id)">
                                    @tag.Name
                                </button>
                            }
                        </div>
                    </div>
                }

                <button type="submit" class="btn btn-primary" disabled="@_busy">
                    @(_busy ? "Saving…" : "Save")
                </button>
                <button type="button" class="btn btn-link" @onclick="CancelForm">Cancel</button>
            </EditForm>
        </div>
    </div>
}

<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <span class="text-muted small">Filter:</span>
    <button class="btn btn-sm @(_activeTagId is null ? "btn-primary" : "btn-outline-secondary")"
            @onclick="() => FilterByTagAsync(null)">All</button>
    @foreach (var tag in _tags)
    {
        <button class="btn btn-sm @(_activeTagId == tag.Id ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => FilterByTagAsync(tag.Id)">@tag.Name</button>
    }
    <input class="form-control form-control-sm" style="max-width: 14rem" placeholder="Search entries…"
           value="@_search" @oninput="SearchInputAsync" />

    <details class="ms-auto">
        <summary class="small text-muted" style="cursor: pointer">Manage tags</summary>
        <div class="mt-2">
            @if (!string.IsNullOrEmpty(_tagError))
            {
                <div class="alert alert-danger py-1 px-2 small" role="alert">@_tagError</div>
            }
            <div class="d-flex align-items-center gap-2 mb-2">
                <input class="form-control form-control-sm" style="max-width: 14rem" placeholder="New tag"
                       @bind="_newTagName" @bind:event="oninput" @onkeydown="TagInputKeyDown" />
                <button class="btn btn-sm btn-primary" @onclick="CreateTagAsync"
                        disabled="@string.IsNullOrWhiteSpace(_newTagName)">Add</button>
            </div>
            @foreach (var tag in _tags)
            {
                <div class="d-flex justify-content-between align-items-center small py-1">
                    <span>@tag.Name</span>
                    <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => DeleteTagAsync(tag)">Remove</button>
                </div>
            }
        </div>
    </details>
</div>

@if (_entries is null)
{
    <Loading Text="Loading entries…" />
}
else if (_entries.Count == 0)
{
    <p class="text-muted">@(_activeTagId is null && string.IsNullOrWhiteSpace(_search) ? "This drawer's empty — add your first entry." : "Nothing on this shelf matches the filter.")</p>
}
else
{
    <div class="list-group">
        @foreach (var entry in _entries)
        {
            @* Favorites reorder this list, so the rows need a stable identity. *@
            <div class="list-group-item" @key="entry.Id">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold">@entry.Name</div>
                        <small class="text-muted">@entry.Username</small>
                        <small class="text-muted d-block">Password changed @DaysAgoText(entry.PasswordChangedAt)</small>
                        @if (entry.Tags.Count > 0)
                        {
                            <div class="mt-1 d-flex flex-wrap gap-1">
                                @foreach (var tag in entry.Tags)
                                {
                                    <span class="badge badge-chip">@tag.Name</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="btn-group">
                        @if (CanWrite)
                        {
                            <button class="btn btn-sm @(entry.IsFavorite ? "btn-warning" : "btn-outline-secondary")"
                                    title="@(entry.IsFavorite ? "Unfavorite" : "Favorite")"
                                    @onclick="() => ToggleFavoriteAsync(entry)">★</button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleRevealAsync(entry.Id)">
                            @(_revealed.ContainsKey(entry.Id) ? "Hide" : "Reveal")
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyPasswordAsync(entry.Id)">
                            @(_copiedId == entry.Id ? "Copied!" : "Copy")
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleHistoryAsync(entry.Id)">
                            @(_historyOpenIds.Contains(entry.Id) ? "Hide history" : "History")
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleAttachmentsAsync(entry.Id)">
                            @(_attachmentsOpenIds.Contains(entry.Id) ? "Hide files" : "Files")
                        </button>
                        @if (CanWrite)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditAsync(entry.Id)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(entry.Id)">Delete</button>
                        }
                    </div>
                </div>
                @if (_revealed.TryGetValue(entry.Id, out var password))
                {
                    <div class="mt-2"><code>@password</code></div>
                }
                @if (_historyOpenIds.Contains(entry.Id))
                {
                    <div class="mt-2">
                        @if (!_history.TryGetValue(entry.Id, out var history))
                        {
                            <Loading Text="Loading history…" Class="small mb-0" />
                        }
                        else if (history.Count == 0)
                        {
                            <p class="text-muted small mb-0">No previous passwords.</p>
                        }
                        else
                        {
                            @foreach (var h in history)
                            {
                                <div class="d-flex justify-content-between align-items-center small py-1 border-top">
                                    <span class="text-muted">@h.CreatedAt.ToLocalTime().ToString("g") · changed by @h.ChangedByUsername</span>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleHistoryRevealAsync(entry.Id, h.Id)">
                                        @(_revealedHistory.ContainsKey(h.Id) ? "Hide" : "Reveal")
                                    </button>
                                </div>
                                @if (_revealedHistory.TryGetValue(h.Id, out var oldPassword))
                                {
                                    <div class="mb-1"><code>@oldPassword</code></div>
                                }
                            }
                        }
                    </div>
                }
                @if (_attachmentsOpenIds.Contains(entry.Id))
                {
                    <div class="mt-2">
                        @if (!_attachments.TryGetValue(entry.Id, out var files))
                        {
                            <Loading Text="Loading files…" Class="small mb-0" />
                        }
                        else
                        {
                            @if (files.Count == 0)
                            {
                                <p class="text-muted small mb-0">No files attached.</p>
                            }
                            else
                            {
                                @foreach (var file in files)
                                {
                                    <div class="d-flex justify-content-between align-items-center small py-1 border-top">
                                        <span>@file.FileName <span class="text-muted">(@FileSizeText(file.FileSizeBytes))</span></span>
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadAttachmentAsync(entry.Id, file)">Download</button>
                                            @if (CanWrite)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAttachmentAsync(entry.Id, file.Id)">Delete</button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            @if (CanWrite)
                            {
                                <div class="mt-2">
                                    <InputFile OnChange="e => UploadAttachmentAsync(entry.Id, e)" />
                                    @if (_attachmentBusyId == entry.Id)
                                    {
                                        <span class="text-muted small ms-2">Uploading…</span>
                                    }
                                </div>
                            }
                            @if (_attachmentError is not null && _attachmentErrorEntryId == entry.Id)
                            {
                                <div class="alert alert-danger py-1 px-2 small mt-2 mb-0" role="alert">@_attachmentError</div>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
}
