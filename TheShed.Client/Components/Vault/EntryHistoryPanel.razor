@if (IsOpen)
{
    <div class="mt-2">
        @if (!string.IsNullOrEmpty(_actionError))
        {
            <div class="alert alert-danger py-1 px-2 small" role="alert">@_actionError</div>
        }
        @if (_history is null)
        {
            <Loading Text="Loading history…" Class="small mb-0" />
        }
        else if (_history.Count == 0)
        {
            <p class="text-muted small mb-0">No previous passwords.</p>
        }
        else
        {
            @foreach (var h in _history)
            {
                <div class="d-flex justify-content-between align-items-center small border-top py-1">
                    <span class="text-muted">@h.CreatedAt.ToLocalTime().ToString("g") · changed by @h.ChangedByUsername</span>
                    <button type="button" class="icon-btn" title="@(_revealedHistory.ContainsKey(h.Id) ? "Hide" : "Reveal")"
                            aria-label="@(_revealedHistory.ContainsKey(h.Id) ? "Hide password" : "Reveal password")"
                            @onclick="() => ToggleHistoryRevealAsync(h.Id)">
                        <span class="bi @(_revealedHistory.ContainsKey(h.Id) ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                    </button>
                </div>
                @if (_revealedHistory.TryGetValue(h.Id, out var oldPassword))
                {
                    <div class="mb-1"><code>@oldPassword</code></div>
                }
            }
        }
    </div>
}
