<div class="list-group-item">
<div class="d-flex justify-content-between align-items-center">
    <div>
        <div class="fw-bold">@Entry.Name</div>
        <small class="text-muted">@Entry.Username</small>
        <small class="text-muted d-block">Password changed @DaysAgoText(Entry.PasswordChangedAt)</small>
        @if (Entry.Tags.Count > 0)
        {
            <div class="d-flex mt-1 flex-wrap gap-1">
                @foreach (var tag in Entry.Tags)
                {
                    <span class="badge badge-chip">@tag.Name</span>
                }
            </div>
        }
    </div>
    <div class="btn-group">
        @if (CanWrite)
        {
            <button class="btn btn-sm @(Entry.IsFavorite ? "btn-warning" : "btn-outline-secondary")"
                    title="@(Entry.IsFavorite ? "Unfavorite" : "Favorite")"
                    @onclick="() => OnFavoriteToggled.InvokeAsync(Entry)">★</button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleRevealAsync">
            @(_revealedPassword is null ? "Reveal" : "Hide")
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="CopyPasswordAsync">
            @(_copied ? "Copied!" : "Copy")
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _historyOpen = !_historyOpen">
            @(_historyOpen ? "Hide history" : "History")
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _attachmentsOpen = !_attachmentsOpen">
            @(_attachmentsOpen ? "Hide files" : "Files")
        </button>
        @if (CanWrite)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnEditRequested.InvokeAsync(Entry.Id)">Edit</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="DeleteAsync">Delete</button>
        }
    </div>
</div>
@if (_revealedPassword is not null)
{
    <div class="mt-2"><code>@_revealedPassword</code></div>
}
@* Mounted unconditionally: an EntryHistoryPanel/EntryAttachmentsPanel instance keeps its
   fetched cache across the toggle above, so reopening never refetches unless the password
   changed under it (see each panel's own OnParametersSetAsync). *@
<EntryHistoryPanel EntryId="Entry.Id" PasswordChangedAt="Entry.PasswordChangedAt" IsOpen="_historyOpen" />
<EntryAttachmentsPanel EntryId="Entry.Id" CanWrite="CanWrite" IsOpen="_attachmentsOpen" />
</div>
