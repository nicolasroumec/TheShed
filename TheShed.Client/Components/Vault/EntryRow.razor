<div class="row-item">
<div class="d-flex justify-content-between align-items-center">
    <div>
        <div class="fw-bold">@Entry.Name</div>
        <small class="text-muted">@Entry.Username</small>
        <small class="text-muted d-block">Password changed @DaysAgoText(Entry.PasswordChangedAt)</small>
        @if (Entry.Tags.Count > 0)
        {
            <div class="d-flex mt-1 flex-wrap gap-1">
                @foreach (var tag in Entry.Tags)
                {
                    <span class="chip">@tag.Name</span>
                }
            </div>
        }
    </div>
    <div class="d-flex align-items-center gap-1 flex-wrap entry-actions">
        @if (CanWrite)
        {
            <button type="button" class="icon-btn @(Entry.IsFavorite ? "active" : "")"
                    title="@(Entry.IsFavorite ? "Unfavorite" : "Favorite")"
                    aria-label="@(Entry.IsFavorite ? "Unfavorite" : "Favorite")"
                    @onclick="() => OnFavoriteToggled.InvokeAsync(Entry)">
                <span class="bi @(Entry.IsFavorite ? "bi-star-fill" : "bi-star")" aria-hidden="true"></span>
            </button>
        }
        <button type="button" class="icon-btn" title="@(_revealedPassword is null ? "Reveal" : "Hide")"
                aria-label="@(_revealedPassword is null ? "Reveal password" : "Hide password")"
                @onclick="ToggleRevealAsync">
            <span class="bi @(_revealedPassword is null ? "bi-eye" : "bi-eye-slash")" aria-hidden="true"></span>
        </button>
        <button type="button" class="icon-btn" title="@(_copied ? "Copied!" : "Copy")"
                aria-label="Copy password" @onclick="CopyPasswordAsync">
            <span class="bi @(_copied ? "bi-clipboard-check" : "bi-clipboard")" aria-hidden="true"></span>
        </button>
        <details class="overflow-menu">
            <summary class="icon-btn" title="More actions" aria-label="More actions">
                <span class="bi bi-three-dots-vertical" aria-hidden="true"></span>
            </summary>
            <div class="overflow-menu-panel">
                <button type="button" @onclick="() => _historyOpen = !_historyOpen">
                    <span class="bi bi-clock-history" aria-hidden="true"></span>
                    @(_historyOpen ? "Hide history" : "History")
                </button>
                <button type="button" @onclick="() => _attachmentsOpen = !_attachmentsOpen">
                    <span class="bi bi-paperclip" aria-hidden="true"></span>
                    @(_attachmentsOpen ? "Hide files" : "Files")
                </button>
                @if (CanWrite)
                {
                    <button type="button" @onclick="() => OnEditRequested.InvokeAsync(Entry.Id)">
                        <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                    </button>
                    <button type="button" class="danger" @onclick="DeleteAsync">
                        <span class="bi bi-trash" aria-hidden="true"></span> Delete
                    </button>
                }
            </div>
        </details>
    </div>
</div>
@if (!string.IsNullOrEmpty(_actionError))
{
    <div class="alert alert-danger py-1 px-2 small mt-1" role="alert">@_actionError</div>
}
@if (_revealedPassword is not null)
{
    <div class="mt-2"><code>@_revealedPassword</code></div>
}
@* Mounted unconditionally: an EntryHistoryPanel/EntryAttachmentsPanel instance keeps its
   fetched cache across the toggle above, so reopening never refetches unless the password
   changed under it (see each panel's own OnParametersSetAsync). *@
<EntryHistoryPanel EntryId="Entry.Id" PasswordChangedAt="Entry.PasswordChangedAt" IsOpen="_historyOpen" VaultKey="VaultKey" />
<EntryAttachmentsPanel EntryId="Entry.Id" CanWrite="CanWrite" IsOpen="_attachmentsOpen" />
</div>
