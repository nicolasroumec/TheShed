<div class="list-group-item">
<div class="d-flex justify-content-between align-items-center">
    <div>
        <div class="fw-bold">@Entry.Name</div>
        <small class="text-muted">@Entry.Username</small>
        <small class="text-muted d-block">Password changed @DaysAgoText(Entry.PasswordChangedAt)</small>
        @if (Entry.Tags.Count > 0)
        {
            <div class="d-flex mt-1 flex-wrap gap-1">
                @foreach (var tag in Entry.Tags)
                {
                    <span class="badge badge-chip">@tag.Name</span>
                }
            </div>
        }
    </div>
    <div class="btn-group">
        @if (CanWrite)
        {
            <button class="btn btn-sm @(Entry.IsFavorite ? "btn-warning" : "btn-outline-secondary")"
                    title="@(Entry.IsFavorite ? "Unfavorite" : "Favorite")"
                    @onclick="() => OnFavoriteToggled.InvokeAsync(Entry)">★</button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleRevealAsync">
            @(_revealedPassword is null ? "Reveal" : "Hide")
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="CopyPasswordAsync">
            @(_copied ? "Copied!" : "Copy")
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleHistoryAsync">
            @(_historyOpen ? "Hide history" : "History")
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleAttachmentsAsync">
            @(_attachmentsOpen ? "Hide files" : "Files")
        </button>
        @if (CanWrite)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnEditRequested.InvokeAsync(Entry.Id)">Edit</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="DeleteAsync">Delete</button>
        }
    </div>
</div>
@if (_revealedPassword is not null)
{
    <div class="mt-2"><code>@_revealedPassword</code></div>
}
@if (_historyOpen)
{
    <div class="mt-2">
        @if (_history is null)
        {
            <Loading Text="Loading history…" Class="small mb-0" />
        }
        else if (_history.Count == 0)
        {
            <p class="text-muted small mb-0">No previous passwords.</p>
        }
        else
        {
            @foreach (var h in _history)
            {
                <div class="d-flex justify-content-between align-items-center small border-top py-1">
                    <span class="text-muted">@h.CreatedAt.ToLocalTime().ToString("g") · changed by @h.ChangedByUsername</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleHistoryRevealAsync(h.Id)">
                        @(_revealedHistory.ContainsKey(h.Id) ? "Hide" : "Reveal")
                    </button>
                </div>
                @if (_revealedHistory.TryGetValue(h.Id, out var oldPassword))
                {
                    <div class="mb-1"><code>@oldPassword</code></div>
                }
            }
        }
    </div>
}
@if (_attachmentsOpen)
{
    <div class="mt-2">
        @if (_attachments is null)
        {
            <Loading Text="Loading files…" Class="small mb-0" />
        }
        else
        {
            @if (_attachments.Count == 0)
            {
                <p class="text-muted small mb-0">No files attached.</p>
            }
            else
            {
                @foreach (var file in _attachments)
                {
                    <div class="d-flex justify-content-between align-items-center small border-top py-1">
                        <span>@file.FileName <span class="text-muted">(@FileSizeText(file.FileSizeBytes))</span></span>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadAttachmentAsync(file)">Download</button>
                            @if (CanWrite)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAttachmentAsync(file.Id)">Delete</button>
                            }
                        </div>
                    </div>
                }
            }
            @if (CanWrite)
            {
                <div class="mt-2">
                    <InputFile OnChange="UploadAttachmentAsync" />
                    @if (_attachmentBusy)
                    {
                        <span class="text-muted small ms-2">Uploading…</span>
                    }
                </div>
            }
            @if (_attachmentError is not null)
            {
                <div class="alert alert-danger small mb-0 mt-2 px-2 py-1" role="alert">@_attachmentError</div>
            }
        }
    </div>
}
</div>
