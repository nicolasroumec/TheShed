<h2 class="h5">Two-factor authentication</h2>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_enabled is null)
{
    <p class="text-muted small">Loading…</p>
}
else if (_enabled.Value)
{
    <p class="text-muted small">
        On. Signing in asks for a code from your authenticator app. To turn it off, enter a
        current code.
    </p>
    <form @onsubmit="Disable">
        <div class="mb-3">
            <label class="form-label" for="disable-code">Authenticator code</label>
            <input id="disable-code" class="form-control" @bind="_code" inputmode="numeric" pattern="[0-9]{6}"
                   maxlength="6" autocomplete="one-time-code" required />
        </div>
        <button type="submit" class="btn btn-outline-danger w-100" disabled="@_busy">Turn off 2FA</button>
    </form>
}
else if (_setup is null)
{
    <p class="text-muted small">
        Adds a second step to signing in: a 6-digit code from an authenticator app (Google
        Authenticator, Authy, 1Password…). It protects your account if your master password leaks.
    </p>
    <button type="button" class="btn btn-outline-primary w-100" disabled="@_busy" @onclick="BeginSetup">
        Set up 2FA
    </button>
}
else
{
    <p class="small">Scan this code with your authenticator app:</p>
    <img class="d-block mx-auto mb-3 rounded" src="@_qrDataUri" width="200" height="200"
         alt="QR code with your two-factor secret" />
    <p class="small">
        Or enter this key by hand:
        <code class="d-block text-break user-select-all">@_setup.Secret</code>
    </p>
    <form @onsubmit="Enable">
        <div class="mb-3">
            <label class="form-label" for="enable-code">Code from the app</label>
            <input id="enable-code" class="form-control" @bind="_code" inputmode="numeric" pattern="[0-9]{6}"
                   maxlength="6" autocomplete="one-time-code" required />
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary flex-fill" disabled="@_busy" @onclick="CancelSetup">Cancel</button>
            <button type="submit" class="btn btn-primary flex-fill" disabled="@_busy">Turn on 2FA</button>
        </div>
    </form>
}
