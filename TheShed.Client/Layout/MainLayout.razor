@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <span class="text-muted">@context.User.FindFirst("username")?.Value</span>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger" role="alert">
                        Something broke on this page. Your data is safe — reload to try again.
                    </div>
                    <a class="btn btn-primary" href="" @onclick:preventDefault @onclick="Reload">Reload</a>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    // Body changes on every navigation, so this clears a previous page's error instead of
    // leaving the boundary stuck showing it forever.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
