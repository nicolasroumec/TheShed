@page "/login"

<PageTitle>Sign in — The Shed</PageTitle>

<div class="auth-card">
    <h1>Sign in</h1>

    <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="_model.Email" autocomplete="username" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="current-password" />
            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
            @(_busy ? "Signing in…" : "Sign in")
        </button>
    </EditForm>

    <p class="mt-3 text-center">
        Don't have an account? <a href="register">Create one</a>
    </p>
</div>
