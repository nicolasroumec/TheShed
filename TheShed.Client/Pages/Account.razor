@page "/account"
@attribute [Authorize]

<PageTitle>Account — The Shed</PageTitle>

<div class="auth-card">
    <h1>Change master password</h1>

    <EditForm Model="@_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }
        @if (_done)
        {
            <div class="alert alert-success" role="status">Master password changed. Use the new one from now on.</div>
        }

        <div class="mb-3">
            <label class="form-label" for="current">Current password</label>
            <InputText id="current" type="password" class="form-control" @bind-Value="_model.CurrentPassword" autocomplete="current-password" />
            <ValidationMessage For="@(() => _model.CurrentPassword)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="new">New password</label>
            <InputText id="new" type="password" class="form-control" @bind-Value="_model.NewPassword" autocomplete="new-password" />
            <ValidationMessage For="@(() => _model.NewPassword)" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="confirm">Confirm new password</label>
            <input id="confirm" type="password" class="form-control" @bind="_confirm" autocomplete="new-password" />
        </div>

        <p class="text-muted small">
            Your vaults stay as they are. Other signed-in devices will need to sign in again.
        </p>

        <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
            @(_busy ? "Changing…" : "Change password")
        </button>
    </EditForm>

    <hr class="my-4" />

    <h2 class="h5">Sign out everywhere</h2>
    <p class="text-muted small">
        Ends every session of this account on every device, this one included. Use it if you
        signed in on a device you no longer trust.
    </p>
    <button type="button" class="btn btn-outline-danger w-100" disabled="@_busy" @onclick="LogoutEverywhere">
        Sign out everywhere
    </button>
</div>
