@page "/vaults/{Id:int}"
@attribute [Authorize]
@using TheShed.Client.Services
@using TheShed.Shared.Models.DTOs.Entries
@using TheShed.Shared.Models.DTOs.Notes
@using TheShed.Shared.Models.DTOs.Vaults
@using TheShed.Shared.Models.Enums
@using TheShed.Shared.Helpers
@inject VaultClient VaultApi
@inject EntryClient EntryApi
@inject NoteClient NoteApi
@inject IJSRuntime JS

<PageTitle>@(_vault?.Name ?? "Vault") — The Shed</PageTitle>

@if (_notFound)
{
    <p class="text-muted">This vault does not exist or you do not have access to it.</p>
    <a href="vaults">← Back to vaults</a>
}
else if (_vault is null)
{
    <p>Loading…</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <a href="vaults">← Vaults</a>
            <h1 class="mt-2">@_vault.Name</h1>
            @if (!string.IsNullOrWhiteSpace(_vault.Description))
            {
                <p class="text-muted">@_vault.Description</p>
            }
        </div>
        @if (_vault.CanWrite)
        {
            <button class="btn btn-primary" @onclick="StartCreate">New entry</button>
        }
    </div>

    @if (_form is not null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@(_editingId is null ? "New entry" : "Edit entry")</h5>
                <EditForm Model="@_form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger" role="alert">@_error</div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="name">Name</label>
                        <InputText id="name" class="form-control" @bind-Value="_form.Name" />
                        <ValidationMessage For="@(() => _form.Name)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <InputText id="username" class="form-control" @bind-Value="_form.Username" autocomplete="off" />
                        <ValidationMessage For="@(() => _form.Username)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <div class="input-group">
                            <InputText id="password" type="@(_showPassword ? "text" : "password")" class="form-control" @bind-Value="_form.Password" autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showPassword = !_showPassword">
                                @(_showPassword ? "Hide" : "Show")
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _form.Password)" />
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GeneratePassword">Generate</button>
                            <label class="form-label mb-0 small">Length</label>
                            <input type="number" min="4" max="128" class="form-control form-control-sm" style="width: 5rem"
                                   @bind="_genLength" />
                            <div class="form-check mb-0">
                                <input id="gen-symbols" type="checkbox" class="form-check-input" @bind="_genSymbols" />
                                <label class="form-check-label small" for="gen-symbols">Symbols</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="url">URL (optional)</label>
                        <InputText id="url" class="form-control" @bind-Value="_form.Url" />
                        <ValidationMessage For="@(() => _form.Url)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="notes">Notes (optional)</label>
                        <InputTextArea id="notes" class="form-control" @bind-Value="_form.Notes" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox id="favorite" class="form-check-input" @bind-Value="_form.IsFavorite" />
                        <label class="form-check-label" for="favorite">Favorite</label>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@_busy">
                        @(_busy ? "Saving…" : "Save")
                    </button>
                    <button type="button" class="btn btn-link" @onclick="CancelForm">Cancel</button>
                </EditForm>
            </div>
        </div>
    }

    @if (_entries is null)
    {
        <p>Loading entries…</p>
    }
    else if (_entries.Count == 0)
    {
        <p class="text-muted">No entries in this vault yet.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var entry in _entries)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">@entry.Name</div>
                            <small class="text-muted">@entry.Username</small>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleRevealAsync(entry.Id)">
                                @(_revealed.ContainsKey(entry.Id) ? "Hide" : "Reveal")
                            </button>
                            @if (_vault.CanWrite)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditAsync(entry.Id)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(entry.Id)">Delete</button>
                            }
                        </div>
                    </div>
                    @if (_revealed.TryGetValue(entry.Id, out var password))
                    {
                        <div class="mt-2"><code>@password</code></div>
                    }
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
        <h2 class="mb-0 h4">Secure notes</h2>
        @if (_vault.CanWrite)
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="StartCreateNote">New note</button>
        }
    </div>

    @if (_noteForm is not null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@(_editingNoteId is null ? "New note" : "Edit note")</h5>
                <EditForm Model="@_noteForm" OnValidSubmit="SubmitNoteAsync">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(_noteError))
                    {
                        <div class="alert alert-danger" role="alert">@_noteError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="note-title">Title</label>
                        <InputText id="note-title" class="form-control" @bind-Value="_noteForm.Title" />
                        <ValidationMessage For="@(() => _noteForm.Title)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="note-content">Content</label>
                        <InputTextArea id="note-content" class="form-control" rows="6" @bind-Value="_noteForm.Content" />
                        <ValidationMessage For="@(() => _noteForm.Content)" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox id="note-favorite" class="form-check-input" @bind-Value="_noteForm.IsFavorite" />
                        <label class="form-check-label" for="note-favorite">Favorite</label>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@_noteBusy">
                        @(_noteBusy ? "Saving…" : "Save")
                    </button>
                    <button type="button" class="btn btn-link" @onclick="CancelNoteForm">Cancel</button>
                </EditForm>
            </div>
        </div>
    }

    @if (_notes is null)
    {
        <p>Loading notes…</p>
    }
    else if (_notes.Count == 0)
    {
        <p class="text-muted">No secure notes in this vault yet.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var note in _notes)
            {
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-bold">@note.Title</div>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleRevealNoteAsync(note.Id)">
                                @(_revealedNotes.ContainsKey(note.Id) ? "Hide" : "Reveal")
                            </button>
                            @if (_vault.CanWrite)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditNoteAsync(note.Id)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteNoteAsync(note.Id)">Delete</button>
                            }
                        </div>
                    </div>
                    @if (_revealedNotes.TryGetValue(note.Id, out var content))
                    {
                        <pre class="mt-2 mb-0" style="white-space: pre-wrap">@content</pre>
                    }
                </div>
            }
        </div>
    }

    @if (_vault.IsOwner)
    {
        <div class="card mt-5">
            <div class="card-body">
                <h5 class="card-title">Members</h5>
                <p class="text-muted small">Share this vault with other users. Viewers can read entries; editors can also add and edit them.</p>

                @if (_members is { Count: > 0 })
                {
                    <div class="list-group mb-3">
                        @foreach (var member in _members)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">@member.Username</div>
                                    <small class="text-muted">@member.Email</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <select class="form-select form-select-sm" style="width: 8rem"
                                            value="@member.Role"
                                            @onchange="e => ChangeRoleAsync(member, e)">
                                        <option value="@VaultRole.Viewer">Viewer</option>
                                        <option value="@VaultRole.Editor">Editor</option>
                                    </select>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMemberAsync(member)">Remove</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">This vault is not shared with anyone yet.</p>
                }

                @if (!string.IsNullOrEmpty(_memberError))
                {
                    <div class="alert alert-danger" role="alert">@_memberError</div>
                }

                <div class="d-flex align-items-center gap-2">
                    <input type="email" class="form-control" placeholder="user@example.com" style="max-width: 20rem"
                           @bind="_memberEmail" />
                    <select class="form-select" style="width: 8rem" @bind="_memberRole">
                        <option value="@VaultRole.Viewer">Viewer</option>
                        <option value="@VaultRole.Editor">Editor</option>
                    </select>
                    <button class="btn btn-primary" disabled="@_memberBusy" @onclick="AddMemberAsync">
                        @(_memberBusy ? "Adding…" : "Add")
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private VaultResponse? _vault;
    private IReadOnlyList<EntryListItem>? _entries;
    private readonly Dictionary<int, string> _revealed = new();
    private bool _notFound;

    private EntryCreateRequest? _form;   // non-null while the create/edit form is open
    private int? _editingId;             // null = creating, otherwise the entry being edited
    private bool _busy;
    private string? _error;

    private bool _showPassword;        // toggles the form password field between text/password
    private int _genLength = 20;       // password generator options
    private bool _genSymbols = true;

    private IReadOnlyList<NoteListItem>? _notes;
    private readonly Dictionary<int, string> _revealedNotes = new();
    private NoteCreateRequest? _noteForm;  // non-null while the note create/edit form is open
    private int? _editingNoteId;           // null = creating, otherwise the note being edited
    private bool _noteBusy;
    private string? _noteError;

    private IReadOnlyList<VaultMemberItem>? _members; // owner-only members panel
    private string _memberEmail = string.Empty;
    private VaultRole _memberRole = VaultRole.Viewer;
    private bool _memberBusy;
    private string? _memberError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vault = await VaultApi.GetAsync(Id);
            _entries = await EntryApi.ListAsync(Id);
            _notes = await NoteApi.ListAsync(Id);
            if (_vault?.IsOwner == true)
            {
                _members = await VaultApi.ListMembersAsync(Id);
            }
        }
        catch (HttpRequestException)
        {
            // 404/403 from the API: vault missing or no access.
            _notFound = true;
        }
    }

    private async Task AddMemberAsync()
    {
        _memberError = null;
        if (string.IsNullOrWhiteSpace(_memberEmail))
        {
            return;
        }

        _memberBusy = true;
        try
        {
            var error = await VaultApi.AddMemberAsync(Id, new VaultMemberAddRequest
            {
                Email = _memberEmail.Trim(),
                Role = _memberRole
            });

            if (error is not null)
            {
                _memberError = error;
                return;
            }

            _memberEmail = string.Empty;
            _memberRole = VaultRole.Viewer;
            _members = await VaultApi.ListMembersAsync(Id);
        }
        finally
        {
            _memberBusy = false;
        }
    }

    private async Task ChangeRoleAsync(VaultMemberItem member, ChangeEventArgs e)
    {
        var role = Enum.Parse<VaultRole>((string)e.Value!);
        await VaultApi.UpdateMemberRoleAsync(Id, member.UserId, new VaultMemberRoleUpdateRequest { Role = role });
        _members = await VaultApi.ListMembersAsync(Id);
    }

    private async Task RemoveMemberAsync(VaultMemberItem member)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Remove {member.Username}'s access to this vault?"))
        {
            return;
        }

        await VaultApi.RemoveMemberAsync(Id, member.UserId);
        _members = await VaultApi.ListMembersAsync(Id);
    }

    private async Task ToggleRevealAsync(int entryId)
    {
        if (_revealed.Remove(entryId))
        {
            return; // was shown, now hidden
        }

        var entry = await EntryApi.GetAsync(entryId);
        if (entry is not null)
        {
            _revealed[entryId] = entry.Password;
        }
    }

    private void StartCreate()
    {
        _editingId = null;
        _error = null;
        _form = new EntryCreateRequest { VaultId = Id };
    }

    private async Task StartEditAsync(int entryId)
    {
        var entry = await EntryApi.GetAsync(entryId);
        if (entry is null)
        {
            return;
        }

        _editingId = entryId;
        _error = null;
        _form = new EntryCreateRequest
        {
            VaultId = Id,
            Name = entry.Name,
            Username = entry.Username,
            Password = entry.Password,
            Url = entry.Url,
            Notes = entry.Notes,
            IsFavorite = entry.IsFavorite
        };
    }

    private void CancelForm()
    {
        _form = null;
        _editingId = null;
        _error = null;
        _showPassword = false;
    }

    private void GeneratePassword()
    {
        if (_form is null)
        {
            return;
        }

        var length = Math.Clamp(_genLength, 4, 128); // guard against out-of-range typed values
        _form.Password = PasswordGenerator.Generate(length, _genSymbols);
        _showPassword = true; // reveal so the user can see what was generated
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (_editingId is null)
            {
                await EntryApi.CreateAsync(_form);
            }
            else
            {
                await EntryApi.UpdateAsync(_editingId.Value, new EntryUpdateRequest
                {
                    Name = _form.Name,
                    Username = _form.Username,
                    Password = _form.Password,
                    Url = _form.Url,
                    Notes = _form.Notes,
                    IsFavorite = _form.IsFavorite
                });
                _revealed.Remove(_editingId.Value); // stale password if it was shown
            }

            CancelForm();
            _entries = await EntryApi.ListAsync(Id);
        }
        catch (Exception)
        {
            _error = "Could not save the entry. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(int entryId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this entry? This cannot be undone."))
        {
            return;
        }

        await EntryApi.DeleteAsync(entryId);
        _revealed.Remove(entryId);
        _entries = await EntryApi.ListAsync(Id);
    }

    // --- Secure notes ---

    private async Task ToggleRevealNoteAsync(int noteId)
    {
        if (_revealedNotes.Remove(noteId))
        {
            return; // was shown, now hidden
        }

        var note = await NoteApi.GetAsync(noteId);
        if (note is not null)
        {
            _revealedNotes[noteId] = note.Content;
        }
    }

    private void StartCreateNote()
    {
        _editingNoteId = null;
        _noteError = null;
        _noteForm = new NoteCreateRequest { VaultId = Id };
    }

    private async Task StartEditNoteAsync(int noteId)
    {
        var note = await NoteApi.GetAsync(noteId);
        if (note is null)
        {
            return;
        }

        _editingNoteId = noteId;
        _noteError = null;
        _noteForm = new NoteCreateRequest
        {
            VaultId = Id,
            Title = note.Title,
            Content = note.Content,
            IsFavorite = note.IsFavorite
        };
    }

    private void CancelNoteForm()
    {
        _noteForm = null;
        _editingNoteId = null;
        _noteError = null;
    }

    private async Task SubmitNoteAsync()
    {
        if (_noteForm is null)
        {
            return;
        }

        _noteBusy = true;
        _noteError = null;
        try
        {
            if (_editingNoteId is null)
            {
                await NoteApi.CreateAsync(_noteForm);
            }
            else
            {
                await NoteApi.UpdateAsync(_editingNoteId.Value, new NoteUpdateRequest
                {
                    Title = _noteForm.Title,
                    Content = _noteForm.Content,
                    IsFavorite = _noteForm.IsFavorite
                });
                _revealedNotes.Remove(_editingNoteId.Value); // stale content if it was shown
            }

            CancelNoteForm();
            _notes = await NoteApi.ListAsync(Id);
        }
        catch (Exception)
        {
            _noteError = "Could not save the note. Please try again.";
        }
        finally
        {
            _noteBusy = false;
        }
    }

    private async Task DeleteNoteAsync(int noteId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this note? This cannot be undone."))
        {
            return;
        }

        await NoteApi.DeleteAsync(noteId);
        _revealedNotes.Remove(noteId);
        _notes = await NoteApi.ListAsync(Id);
    }
}
