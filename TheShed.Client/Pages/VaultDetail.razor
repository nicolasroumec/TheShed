@page "/vaults/{Id:int}"
@attribute [Authorize]

<PageTitle>@(_vault?.Name ?? "Vault") — The Shed</PageTitle>

@if (_notFound)
{
    <p class="text-muted">This vault does not exist or you do not have access to it.</p>
    <a href="vaults">← Back to vaults</a>
}
else if (_vault is null)
{
    <Loading />
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <a href="vaults">← Vaults</a>
            <h1 class="mt-2">@_vault.Name</h1>
            @if (!string.IsNullOrWhiteSpace(_vault.Description))
            {
                <p class="text-muted">@_vault.Description</p>
            }
        </div>
        @if (_vault.CanWrite)
        {
            <button class="btn btn-primary" @onclick="() => _entriesPanel?.StartCreate()">New entry</button>
        }
    </div>

    <EntriesPanel @ref="_entriesPanel" VaultId="Id" CanWrite="_vault.CanWrite" />

    <NotesPanel VaultId="Id" CanWrite="_vault.CanWrite" />

    @if (_vault.IsOwner)
    {
        <MembersPanel VaultId="Id" />
    }
}
