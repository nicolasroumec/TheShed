@page "/vaults/{Id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@using TheShed.Client.Services
@using TheShed.Shared.Models.DTOs.Attachments
@using TheShed.Shared.Models.DTOs.Entries
@using TheShed.Shared.Models.DTOs.Notes
@using TheShed.Shared.Models.DTOs.Tags
@using TheShed.Shared.Models.DTOs.Vaults
@using TheShed.Shared.Helpers
@inject VaultClient VaultApi
@inject EntryClient EntryApi
@inject NoteClient NoteApi
@inject TagClient TagApi
@inject AttachmentClient AttachmentApi
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(_vault?.Name ?? "Vault") — The Shed</PageTitle>

@if (_notFound)
{
    <p class="text-muted">This vault does not exist or you do not have access to it.</p>
    <a href="vaults">← Back to vaults</a>
}
else if (_vault is null)
{
    <Loading />
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <a href="vaults">← Vaults</a>
            <h1 class="mt-2">@_vault.Name</h1>
            @if (!string.IsNullOrWhiteSpace(_vault.Description))
            {
                <p class="text-muted">@_vault.Description</p>
            }
        </div>
        @if (_vault.CanWrite)
        {
            <button class="btn btn-primary" @onclick="StartCreate">New entry</button>
        }
    </div>

    @* One banner for every list-level action (favorite, delete, share). The form errors
       below have their own, because they belong to the form that is open. *@
    @if (!string.IsNullOrEmpty(_actionError))
    {
        <div class="alert alert-danger" role="alert">@_actionError</div>
    }

    @if (_form is not null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@(_editingId is null ? "New entry" : "Edit entry")</h5>
                <EditForm Model="@_form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger" role="alert">@_error</div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="name">Name</label>
                        <InputText id="name" class="form-control" @bind-Value="_form.Name" />
                        <ValidationMessage For="@(() => _form.Name)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <InputText id="username" class="form-control" @bind-Value="_form.Username" autocomplete="off" />
                        <ValidationMessage For="@(() => _form.Username)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <div class="input-group">
                            <InputText id="password" type="@(_showPassword ? "text" : "password")" class="form-control secret" @bind-Value="_form.Password" autocomplete="off" />
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => _showPassword = !_showPassword">
                                @(_showPassword ? "Hide" : "Show")
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _form.Password)" />
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GeneratePassword">Generate</button>
                            <label class="form-label mb-0 small">Length</label>
                            <input type="number" min="4" max="128" class="form-control form-control-sm" style="width: 5rem"
                                   @bind="_genLength" />
                            <div class="form-check mb-0">
                                <input id="gen-symbols" type="checkbox" class="form-check-input" @bind="_genSymbols" />
                                <label class="form-check-label small" for="gen-symbols">Symbols</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="url">URL (optional)</label>
                        <InputText id="url" class="form-control" @bind-Value="_form.Url" />
                        <ValidationMessage For="@(() => _form.Url)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="notes">Notes (optional)</label>
                        <InputTextArea id="notes" class="form-control" @bind-Value="_form.Notes" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox id="favorite" class="form-check-input" @bind-Value="_form.IsFavorite" />
                        <label class="form-check-label" for="favorite">Favorite</label>
                    </div>

                    @if (_editingId is not null && _tags.Count > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label">Tags</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var tag in _tags)
                                {
                                    var assigned = _formTagIds.Contains(tag.Id);
                                    <button type="button"
                                            class="btn btn-sm @(assigned ? "btn-primary" : "btn-outline-secondary")"
                                            @onclick="() => ToggleEntryTagAsync(tag.Id)">
                                        @tag.Name
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary" disabled="@_busy">
                        @(_busy ? "Saving…" : "Save")
                    </button>
                    <button type="button" class="btn btn-link" @onclick="CancelForm">Cancel</button>
                </EditForm>
            </div>
        </div>
    }

    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted small">Filter:</span>
        <button class="btn btn-sm @(_activeTagId is null ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => FilterByTagAsync(null)">All</button>
        @foreach (var tag in _tags)
        {
            <button class="btn btn-sm @(_activeTagId == tag.Id ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => FilterByTagAsync(tag.Id)">@tag.Name</button>
        }
        <input class="form-control form-control-sm" style="max-width: 14rem" placeholder="Search entries…"
               value="@_search" @oninput="SearchInputAsync" />

        <details class="ms-auto">
            <summary class="small text-muted" style="cursor: pointer">Manage tags</summary>
            <div class="mt-2">
                @if (!string.IsNullOrEmpty(_tagError))
                {
                    <div class="alert alert-danger py-1 px-2 small" role="alert">@_tagError</div>
                }
                <div class="d-flex align-items-center gap-2 mb-2">
                    <input class="form-control form-control-sm" style="max-width: 14rem" placeholder="New tag"
                           @bind="_newTagName" @bind:event="oninput" @onkeydown="TagInputKeyDown" />
                    <button class="btn btn-sm btn-primary" @onclick="CreateTagAsync"
                            disabled="@string.IsNullOrWhiteSpace(_newTagName)">Add</button>
                </div>
                @foreach (var tag in _tags)
                {
                    <div class="d-flex justify-content-between align-items-center small py-1">
                        <span>@tag.Name</span>
                        <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => DeleteTagAsync(tag)">Remove</button>
                    </div>
                }
            </div>
        </details>
    </div>

    @if (_entries is null)
    {
        <Loading Text="Loading entries…" />
    }
    else if (_entries.Count == 0)
    {
        <p class="text-muted">@(_activeTagId is null && string.IsNullOrWhiteSpace(_search) ? "This drawer's empty — add your first entry." : "Nothing on this shelf matches the filter.")</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var entry in _entries)
            {
                @* Favorites reorder this list, so the rows need a stable identity. *@
                <div class="list-group-item" @key="entry.Id">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">@entry.Name</div>
                            <small class="text-muted">@entry.Username</small>
                            <small class="text-muted d-block">Password changed @DaysAgoText(entry.PasswordChangedAt)</small>
                            @if (entry.Tags.Count > 0)
                            {
                                <div class="mt-1 d-flex flex-wrap gap-1">
                                    @foreach (var tag in entry.Tags)
                                    {
                                        <span class="badge badge-chip">@tag.Name</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="btn-group">
                            @if (_vault.CanWrite)
                            {
                                <button class="btn btn-sm @(entry.IsFavorite ? "btn-warning" : "btn-outline-secondary")"
                                        title="@(entry.IsFavorite ? "Unfavorite" : "Favorite")"
                                        @onclick="() => ToggleFavoriteAsync(entry)">★</button>
                            }
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleRevealAsync(entry.Id)">
                                @(_revealed.ContainsKey(entry.Id) ? "Hide" : "Reveal")
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyPasswordAsync(entry.Id)">
                                @(_copiedId == entry.Id ? "Copied!" : "Copy")
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleHistoryAsync(entry.Id)">
                                @(_historyOpenIds.Contains(entry.Id) ? "Hide history" : "History")
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleAttachmentsAsync(entry.Id)">
                                @(_attachmentsOpenIds.Contains(entry.Id) ? "Hide files" : "Files")
                            </button>
                            @if (_vault.CanWrite)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditAsync(entry.Id)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(entry.Id)">Delete</button>
                            }
                        </div>
                    </div>
                    @if (_revealed.TryGetValue(entry.Id, out var password))
                    {
                        <div class="mt-2"><code>@password</code></div>
                    }
                    @if (_historyOpenIds.Contains(entry.Id))
                    {
                        <div class="mt-2">
                            @if (!_history.TryGetValue(entry.Id, out var history))
                            {
                                <Loading Text="Loading history…" Class="small mb-0" />
                            }
                            else if (history.Count == 0)
                            {
                                <p class="text-muted small mb-0">No previous passwords.</p>
                            }
                            else
                            {
                                @foreach (var h in history)
                                {
                                    <div class="d-flex justify-content-between align-items-center small py-1 border-top">
                                        <span class="text-muted">@h.CreatedAt.ToLocalTime().ToString("g") · changed by @h.ChangedByUsername</span>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleHistoryRevealAsync(entry.Id, h.Id)">
                                            @(_revealedHistory.ContainsKey(h.Id) ? "Hide" : "Reveal")
                                        </button>
                                    </div>
                                    @if (_revealedHistory.TryGetValue(h.Id, out var oldPassword))
                                    {
                                        <div class="mb-1"><code>@oldPassword</code></div>
                                    }
                                }
                            }
                        </div>
                    }
                    @if (_attachmentsOpenIds.Contains(entry.Id))
                    {
                        <div class="mt-2">
                            @if (!_attachments.TryGetValue(entry.Id, out var files))
                            {
                                <Loading Text="Loading files…" Class="small mb-0" />
                            }
                            else
                            {
                                @if (files.Count == 0)
                                {
                                    <p class="text-muted small mb-0">No files attached.</p>
                                }
                                else
                                {
                                    @foreach (var file in files)
                                    {
                                        <div class="d-flex justify-content-between align-items-center small py-1 border-top">
                                            <span>@file.FileName <span class="text-muted">(@FileSizeText(file.FileSizeBytes))</span></span>
                                            <div class="btn-group">
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadAttachmentAsync(entry.Id, file)">Download</button>
                                                @if (_vault.CanWrite)
                                                {
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAttachmentAsync(entry.Id, file.Id)">Delete</button>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                @if (_vault.CanWrite)
                                {
                                    <div class="mt-2">
                                        <InputFile OnChange="e => UploadAttachmentAsync(entry.Id, e)" />
                                        @if (_attachmentBusyId == entry.Id)
                                        {
                                            <span class="text-muted small ms-2">Uploading…</span>
                                        }
                                    </div>
                                }
                                @if (_attachmentError is not null && _attachmentErrorEntryId == entry.Id)
                                {
                                    <div class="alert alert-danger py-1 px-2 small mt-2 mb-0" role="alert">@_attachmentError</div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
        <h2 class="mb-0 h4">Secure notes</h2>
        @if (_vault.CanWrite)
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="StartCreateNote">New note</button>
        }
    </div>

    @if (_noteForm is not null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@(_editingNoteId is null ? "New note" : "Edit note")</h5>
                <EditForm Model="@_noteForm" OnValidSubmit="SubmitNoteAsync">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(_noteError))
                    {
                        <div class="alert alert-danger" role="alert">@_noteError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="note-title">Title</label>
                        <InputText id="note-title" class="form-control" @bind-Value="_noteForm.Title" />
                        <ValidationMessage For="@(() => _noteForm.Title)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="note-content">Content</label>
                        <InputTextArea id="note-content" class="form-control" rows="6" @bind-Value="_noteForm.Content" />
                        <ValidationMessage For="@(() => _noteForm.Content)" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox id="note-favorite" class="form-check-input" @bind-Value="_noteForm.IsFavorite" />
                        <label class="form-check-label" for="note-favorite">Favorite</label>
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@_noteBusy">
                        @(_noteBusy ? "Saving…" : "Save")
                    </button>
                    <button type="button" class="btn btn-link" @onclick="CancelNoteForm">Cancel</button>
                </EditForm>
            </div>
        </div>
    }

    @if (_notes is null)
    {
        <Loading Text="Loading notes…" />
    }
    else if (_notes.Count == 0)
    {
        <p class="text-muted">No notes pinned to this drawer yet.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var note in _notes)
            {
                <div class="list-group-item" @key="note.Id">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-bold">@note.Title</div>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleRevealNoteAsync(note.Id)">
                                @(_revealedNotes.ContainsKey(note.Id) ? "Hide" : "Reveal")
                            </button>
                            @if (_vault.CanWrite)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEditNoteAsync(note.Id)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteNoteAsync(note.Id)">Delete</button>
                            }
                        </div>
                    </div>
                    @if (_revealedNotes.TryGetValue(note.Id, out var content))
                    {
                        <pre class="mt-2 mb-0" style="white-space: pre-wrap">@content</pre>
                    }
                </div>
            }
        </div>
    }

    @if (_vault.IsOwner)
    {
        <MembersPanel VaultId="Id" />
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private VaultResponse? _vault;
    private IReadOnlyList<EntryListItem>? _entries;
    private readonly Dictionary<int, string> _revealed = new();
    private int? _copiedId;         // drives the transient "Copied!" label; the password itself is never rendered
    private string? _actionError;   // failures of list-level actions (favorite, delete, share)
    private CancellationTokenSource? _searchCts;
    private readonly HashSet<int> _historyOpenIds = new();                                   // entry ids with the history panel open
    private readonly Dictionary<int, IReadOnlyList<EntryHistoryItem>> _history = new();       // entryId -> past passwords (metadata)
    private readonly Dictionary<int, string> _revealedHistory = new();                        // historyId -> decrypted old password
    private bool _notFound;

    private readonly HashSet<int> _attachmentsOpenIds = new();                                // entry ids with the files panel open
    private readonly Dictionary<int, IReadOnlyList<AttachmentResponse>> _attachments = new();  // entryId -> attachments
    private int? _attachmentBusyId;     // entry id currently uploading, for the "Uploading…" label
    private string? _attachmentError;
    private int? _attachmentErrorEntryId;

    private EntryCreateRequest? _form;   // non-null while the create/edit form is open
    private int? _editingId;             // null = creating, otherwise the entry being edited
    private bool _busy;
    private string? _error;

    private static readonly TimeSpan SearchDebounce = TimeSpan.FromMilliseconds(300);
    private static readonly TimeSpan CopiedLabelDuration = TimeSpan.FromSeconds(2);

    private bool _showPassword;        // toggles the form password field between text/password
    private int _genLength = 20;       // password generator options
    private bool _genSymbols = true;

    private IReadOnlyList<TagResponse> _tags = [];      // the caller's tags (per-user)
    private int? _activeTagId;                          // null = no tag filter
    private string _search = string.Empty;               // empty = no search filter
    private readonly HashSet<int> _formTagIds = new();  // tags on the entry being edited
    private string _newTagName = string.Empty;
    private string? _tagError;

    private IReadOnlyList<NoteListItem>? _notes;
    private readonly Dictionary<int, string> _revealedNotes = new();
    private NoteCreateRequest? _noteForm;  // non-null while the note create/edit form is open
    private int? _editingNoteId;           // null = creating, otherwise the note being edited
    private bool _noteBusy;
    private string? _noteError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vault = await VaultApi.GetAsync(Id);
            await LoadEntriesAsync();
            _notes = await NoteApi.ListAsync(Id);
            _tags = await TagApi.ListAsync();
        }
        catch (HttpRequestException)
        {
            // 404/403 from the API: vault missing or no access.
            _notFound = true;
        }
    }

    private async Task ToggleRevealAsync(int entryId)
    {
        if (_revealed.Remove(entryId))
        {
            return; // was shown, now hidden
        }

        var entry = await EntryApi.GetAsync(entryId);
        if (entry is not null)
        {
            _revealed[entryId] = entry.Password;
        }
    }

    private async Task CopyPasswordAsync(int entryId)
    {
        var entry = await EntryApi.GetAsync(entryId);
        if (entry is null)
        {
            return;
        }

        await JS.InvokeVoidAsync("copyToClipboard", entry.Password);

        // Flash "Copied!" and put the button back. StateHasChanged is needed here because the
        // label has to update before the delay, not after the handler finally returns.
        _copiedId = entryId;
        StateHasChanged();
        await Task.Delay(CopiedLabelDuration);
        if (_copiedId == entryId)
        {
            _copiedId = null;
        }
    }

    private static string DaysAgoText(DateTime changedAt)
    {
        var days = (int)(DateTime.UtcNow - changedAt).TotalDays;
        return days switch
        {
            0 => "today",
            1 => "1 day ago",
            _ => $"{days} days ago"
        };
    }

    private async Task ToggleHistoryAsync(int entryId)
    {
        if (!_historyOpenIds.Add(entryId))
        {
            _historyOpenIds.Remove(entryId); // was open, now closed
            return;
        }

        if (!_history.ContainsKey(entryId))
        {
            _history[entryId] = await EntryApi.GetHistoryAsync(entryId);
        }
    }

    private async Task ToggleHistoryRevealAsync(int entryId, int historyId)
    {
        if (_revealedHistory.Remove(historyId))
        {
            return; // was shown, now hidden
        }

        var detail = await EntryApi.GetHistoryEntryAsync(entryId, historyId);
        if (detail is not null)
        {
            _revealedHistory[historyId] = detail.Password;
        }
    }

    // --- Attachments ---

    private async Task ToggleAttachmentsAsync(int entryId)
    {
        if (!_attachmentsOpenIds.Add(entryId))
        {
            _attachmentsOpenIds.Remove(entryId); // was open, now closed
            return;
        }

        _attachments[entryId] = await AttachmentApi.ListAsync(entryId);
    }

    private static string FileSizeText(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / 1024.0 / 1024.0:0.#} MB";

    private async Task UploadAttachmentAsync(int entryId, InputFileChangeEventArgs e)
    {
        _attachmentError = null;
        _attachmentBusyId = entryId;
        try
        {
            var response = await AttachmentApi.UploadAsync(entryId, e.File);
            if (!response.IsSuccessStatusCode)
            {
                _attachmentError = "Could not upload the file. Check the size (max 5 MB) and type (.pdf, .jpg, .jpeg, .png, .txt).";
                _attachmentErrorEntryId = entryId;
                return;
            }
            _attachments[entryId] = await AttachmentApi.ListAsync(entryId);
        }
        catch (Exception)
        {
            _attachmentError = "Could not upload the file. Please try again.";
            _attachmentErrorEntryId = entryId;
        }
        finally
        {
            _attachmentBusyId = null;
        }
    }

    private async Task DownloadAttachmentAsync(int entryId, AttachmentResponse file)
    {
        var (fileName, content) = await AttachmentApi.DownloadAsync(entryId, file.Id);
        await JS.InvokeVoidAsync("downloadFile", fileName, content);
    }

    private async Task DeleteAttachmentAsync(int entryId, int attachmentId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this file? This cannot be undone."))
        {
            return;
        }

        _attachmentError = null;
        try
        {
            await AttachmentApi.DeleteAsync(entryId, attachmentId);
            _attachments[entryId] = await AttachmentApi.ListAsync(entryId);
        }
        catch (Exception)
        {
            _attachmentError = "Could not delete the file. Please try again.";
            _attachmentErrorEntryId = entryId;
        }
    }

    private void StartCreate()
    {
        _editingId = null;
        _error = null;
        _form = new EntryCreateRequest { VaultId = Id };
    }

    private async Task StartEditAsync(int entryId)
    {
        var entry = await EntryApi.GetAsync(entryId);
        if (entry is null)
        {
            return;
        }

        _editingId = entryId;
        _error = null;
        _formTagIds.Clear();
        foreach (var tag in entry.Tags)
        {
            _formTagIds.Add(tag.Id);
        }
        _form = new EntryCreateRequest
        {
            VaultId = Id,
            Name = entry.Name,
            Username = entry.Username,
            Password = entry.Password,
            Url = entry.Url,
            Notes = entry.Notes,
            IsFavorite = entry.IsFavorite
        };
    }

    private void CancelForm()
    {
        _form = null;
        _editingId = null;
        _error = null;
        _showPassword = false;
        _formTagIds.Clear();
    }

    private async Task LoadEntriesAsync(CancellationToken cancellationToken = default)
    {
        _entries = await EntryApi.ListAsync(Id, _activeTagId, _search, cancellationToken);
    }

    /// <summary>Search-as-you-type: waits out the typing, then loads. Cancelling the previous
    /// token drops both the pending wait and any request already in flight, so a slow response
    /// can never land after a newer one.</summary>
    private async Task SearchInputAsync(ChangeEventArgs e)
    {
        _search = (string?)e.Value ?? string.Empty;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(SearchDebounce, token);
            await LoadEntriesAsync(token);
        }
        catch (OperationCanceledException)
        {
            // Another keystroke arrived; that call owns the results now.
        }
    }

    private async Task ToggleFavoriteAsync(EntryListItem entry)
    {
        _actionError = null;
        try
        {
            await EntryApi.SetFavoriteAsync(entry.Id, !entry.IsFavorite);
            await LoadEntriesAsync();
        }
        catch (Exception)
        {
            _actionError = "Could not update the favorite. Please try again.";
        }
    }

    public void Dispose() => _searchCts?.Dispose();

    // --- Tags ---

    private async Task FilterByTagAsync(int? tagId)
    {
        _activeTagId = tagId;
        await LoadEntriesAsync();
    }

    private async Task CreateTagAsync()
    {
        var name = _newTagName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        _tagError = null;
        try
        {
            await TagApi.CreateAsync(new TagCreateRequest { Name = name });
            _newTagName = string.Empty;
            _tags = await TagApi.ListAsync();
        }
        catch (Exception)
        {
            _tagError = "Could not create the tag. The name may already be in use.";
        }
    }

    private async Task TagInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateTagAsync();
        }
    }

    private async Task DeleteTagAsync(TagResponse tag)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Remove the tag \"{tag.Name}\"? It will be removed from all entries."))
        {
            return;
        }

        _tagError = null;
        try
        {
            await TagApi.DeleteAsync(tag.Id);
            if (_activeTagId == tag.Id)
            {
                _activeTagId = null; // the filtered-by tag is gone
            }
            _formTagIds.Remove(tag.Id);
            _tags = await TagApi.ListAsync();
            await LoadEntriesAsync(); // badges/filter may have changed
        }
        catch (Exception)
        {
            _tagError = "Could not remove the tag. Please try again.";
        }
    }

    private async Task ToggleEntryTagAsync(int tagId)
    {
        if (_editingId is null)
        {
            return; // assignment needs a persisted entry
        }

        if (_formTagIds.Contains(tagId))
        {
            await EntryApi.RemoveTagAsync(_editingId.Value, tagId);
            _formTagIds.Remove(tagId);
        }
        else
        {
            await EntryApi.AddTagAsync(_editingId.Value, tagId);
            _formTagIds.Add(tagId);
        }
    }

    private void GeneratePassword()
    {
        if (_form is null)
        {
            return;
        }

        var length = Math.Clamp(_genLength, 4, 128); // guard against out-of-range typed values
        _form.Password = PasswordGenerator.Generate(length, _genSymbols);
        _showPassword = true; // reveal so the user can see what was generated
    }

    private async Task SubmitAsync()
    {
        if (_form is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            if (_editingId is null)
            {
                await EntryApi.CreateAsync(_form);
            }
            else
            {
                await EntryApi.UpdateAsync(_editingId.Value, new EntryUpdateRequest
                {
                    Name = _form.Name,
                    Username = _form.Username,
                    Password = _form.Password,
                    Url = _form.Url,
                    Notes = _form.Notes,
                    IsFavorite = _form.IsFavorite
                });
                _revealed.Remove(_editingId.Value); // stale password if it was shown
                _history.Remove(_editingId.Value);  // stale: the update may have added a new version
                _historyOpenIds.Remove(_editingId.Value);
            }

            CancelForm();
            await LoadEntriesAsync();
        }
        catch (Exception)
        {
            _error = "Could not save the entry. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(int entryId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this entry? This cannot be undone."))
        {
            return;
        }

        _actionError = null;
        try
        {
            await EntryApi.DeleteAsync(entryId);
            _revealed.Remove(entryId);
            await LoadEntriesAsync();
        }
        catch (Exception)
        {
            _actionError = "Could not delete the entry. Please try again.";
        }
    }

    // --- Secure notes ---

    private async Task ToggleRevealNoteAsync(int noteId)
    {
        if (_revealedNotes.Remove(noteId))
        {
            return; // was shown, now hidden
        }

        var note = await NoteApi.GetAsync(noteId);
        if (note is not null)
        {
            _revealedNotes[noteId] = note.Content;
        }
    }

    private void StartCreateNote()
    {
        _editingNoteId = null;
        _noteError = null;
        _noteForm = new NoteCreateRequest { VaultId = Id };
    }

    private async Task StartEditNoteAsync(int noteId)
    {
        var note = await NoteApi.GetAsync(noteId);
        if (note is null)
        {
            return;
        }

        _editingNoteId = noteId;
        _noteError = null;
        _noteForm = new NoteCreateRequest
        {
            VaultId = Id,
            Title = note.Title,
            Content = note.Content,
            IsFavorite = note.IsFavorite
        };
    }

    private void CancelNoteForm()
    {
        _noteForm = null;
        _editingNoteId = null;
        _noteError = null;
    }

    private async Task SubmitNoteAsync()
    {
        if (_noteForm is null)
        {
            return;
        }

        _noteBusy = true;
        _noteError = null;
        try
        {
            if (_editingNoteId is null)
            {
                await NoteApi.CreateAsync(_noteForm);
            }
            else
            {
                await NoteApi.UpdateAsync(_editingNoteId.Value, new NoteUpdateRequest
                {
                    Title = _noteForm.Title,
                    Content = _noteForm.Content,
                    IsFavorite = _noteForm.IsFavorite
                });
                _revealedNotes.Remove(_editingNoteId.Value); // stale content if it was shown
            }

            CancelNoteForm();
            _notes = await NoteApi.ListAsync(Id);
        }
        catch (Exception)
        {
            _noteError = "Could not save the note. Please try again.";
        }
        finally
        {
            _noteBusy = false;
        }
    }

    private async Task DeleteNoteAsync(int noteId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this note? This cannot be undone."))
        {
            return;
        }

        _actionError = null;
        try
        {
            await NoteApi.DeleteAsync(noteId);
            _revealedNotes.Remove(noteId);
            _notes = await NoteApi.ListAsync(Id);
        }
        catch (Exception)
        {
            _actionError = "Could not delete the note. Please try again.";
        }
    }
}
