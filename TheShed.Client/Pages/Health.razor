@page "/health"
@attribute [Authorize]
@using TheShed.Client.Services
@using TheShed.Shared.Helpers
@using TheShed.Shared.Models.DTOs.Health

<PageTitle>Password health — The Shed</PageTitle>

<h1 class="mb-4">Password health</h1>

@if (_items is null)
{
    <Loading />
}
else if (_items.Count == 0)
{
    <p class="text-muted"><span class="bi bi-shield-check me-2" aria-hidden="true"></span>Nothing to inspect yet — add an entry first.</p>
}
else
{
    <div class="row-list">
        @foreach (var item in _items)
        {
            <div class="row-item">
                <div class="d-flex justify-content-between align-items-center">
                    <a href="@($"vaults/{item.VaultId}")">@item.EntryName</a>
                    <div class="d-flex align-items-center gap-2">
                        <span class="chip @StrengthChipClass(item.Strength)">@item.Strength</span>
                        @if (item.IsReused)
                        {
                            <span class="chip reused">Reused</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
