@page "/trash"
@attribute [Authorize]
@using TheShed.Client.Services
@using TheShed.Shared.Models.DTOs.Trash
@using TheShed.Shared.Models.Enums

<PageTitle>Trash — The Shed</PageTitle>

<h1 class="mb-4">Trash</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_items is null)
{
    <Loading />
}
else if (_items.Count == 0)
{
    <p class="text-muted"><span class="bi bi-trash me-2" aria-hidden="true"></span>Nothing swept up yet — the bin's clean.</p>
}
else
{
    <div class="row-list">
        @foreach (var item in _items)
        {
            <div class="row-item">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="chip me-2">@item.Type</span>
                        <span class="fw-bold">@item.Name</span>
                        @if (item.VaultName is not null)
                        {
                            <small class="text-muted d-block">in @item.VaultName</small>
                        }
                        <small class="text-muted d-block">Deleted @DaysAgoText(item.DeletedAt) · @ExpiresText(item.ExpiresAt)</small>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="icon-btn" title="Restore" aria-label="Restore" @onclick="() => RestoreAsync(item)">
                            <span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span>
                        </button>
                        <button type="button" class="icon-btn danger" title="Delete forever" aria-label="Delete forever" @onclick="() => PurgeAsync(item)">
                            <span class="bi bi-trash" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}
