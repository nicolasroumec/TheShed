@page "/vaults"
@attribute [Authorize]
@using TheShed.Client.Services
@using TheShed.Shared.Models.DTOs.Vaults

<PageTitle>Vaults — The Shed</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Vaults</h1>
    <button class="btn btn-primary" @onclick="ToggleCreate">@(_showCreate ? "Cancel" : "New vault")</button>
</div>

@if (_showCreate)
{
    <div class="job-form mb-4">
        <EditForm Model="@_newVault" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }

            <div class="mb-3">
                <label class="form-label" for="name">Name</label>
                <InputText id="name" class="form-control" @bind-Value="_newVault.Name" />
                <ValidationMessage For="@(() => _newVault.Name)" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="description">Description (optional)</label>
                <InputText id="description" class="form-control" @bind-Value="_newVault.Description" />
                <ValidationMessage For="@(() => _newVault.Description)" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @(_busy ? "Creating…" : "Create vault")
            </button>
        </EditForm>
    </div>
}

@if (_vaults is null)
{
    <Loading />
}
else if (_vaults.Count == 0)
{
    <p class="text-muted"><span class="bi bi-archive me-2" aria-hidden="true"></span>The shed's empty — hang your first vault.</p>
}
else
{
    <div class="row g-3">
        @foreach (var vault in _vaults)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="vault-tile h-100 @(vault.IsOwner ? "role-owner" : "")" href="@($"vaults/{vault.Id}")">
                    <div class="fw-bold">@vault.Name</div>
                    @if (!string.IsNullOrWhiteSpace(vault.Description))
                    {
                        <small class="text-muted d-block">@vault.Description</small>
                    }
                    <span class="chip mt-2">@RoleLabel(vault)</span>
                </a>
            </div>
        }
    </div>
}
